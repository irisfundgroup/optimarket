{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string"
    },
    "sender_email": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "receiver_email": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "related_type": {
      "type": "string",
      "enum": [
        "product",
        "service",
        "service_request",
        "general"
      ]
    },
    "related_id": {
      "type": "string"
    }
  },
  "required": [
    "sender_email",
    "receiver_email",
    "message"
  ]
}