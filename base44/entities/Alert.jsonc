{
  "name": "Alert",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "new_product",
        "new_service",
        "opportunity",
        "flash_sale",
        "price_drop",
        "service_request_match",
        "vip"
      ]
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "is_vip": {
      "type": "boolean",
      "default": false
    },
    "related_id": {
      "type": "string"
    },
    "related_type": {
      "type": "string",
      "enum": [
        "product",
        "service",
        "opportunity",
        "flash_sale",
        "service_request"
      ]
    },
    "category": {
      "type": "string"
    },
    "location_city": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "type",
    "title"
  ]
}